# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

.env*
!.env.local.example

# claude code — machine-local settings (auth token, etc.), not shared
.claude/settings.local.json

# stray Git Bash crash dumps
*.stackdump

# Android release signing — belt-and-suspenders on top of android/.gitignore,
# since this is exactly the kind of file that must never end up in git
# history (unlike most secrets, a leaked signing key can't be rotated —
# Play Store apps are tied to it for life).
*.jks
*.keystore
key.properties
