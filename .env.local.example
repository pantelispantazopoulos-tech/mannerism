# Copy this file to .env.local and fill in the values from your Supabase project
# Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — Settings -> API -> service_role (Supabase dashboard). Never
# prefix this with NEXT_PUBLIC_; it bypasses RLS entirely and must only be
# read by server code (src/lib/supabase/admin.ts, used by the Stripe
# webhook route to write subscription state RLS blocks the browser from
# writing directly).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe -------------------------------------------------------------
# TEST MODE keys for now (Stripe Dashboard -> Developers -> API keys, with
# "Test mode" toggled on — test secret keys start with sk_test_). When
# you're ready to take real payments, switch the Stripe Dashboard toggle to
# live mode, grab the sk_live_ key, and set these two as PRODUCTION
# environment variables in Vercel — nothing in the code needs to change,
# Stripe keys carry their own mode. Do the same for the webhook secret
# below once you've added a live-mode endpoint in the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_...

# Developers -> Webhooks -> your endpoint -> Signing secret. Test mode and
# live mode each get their own endpoint (and therefore their own secret) in
# the Stripe Dashboard, even though they point at the same URL
# (/api/stripe/webhook) — the mode is determined by which key created the
# event, not the URL.
STRIPE_WEBHOOK_SECRET=whsec_...
